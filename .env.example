# Form submissions for the Students Organize For Syria site (app/api/forms/route.ts)
# Copy to .env.local for local dev. In production set these as Vercel Environment
# Variables or Cloudflare Worker secrets/vars. Configure at least ONE channel;
# if none is set, the forms answer 503 and visitors get a prefilled email link instead.

# Option A: webhook. Each submission is POSTed as JSON:
#   { source, type, submittedAt, page, secret?, data: { ...fields } }
# Works with a Google Apps Script web app (Google Sheet), Zapier, Make, n8n, etc.
# Must be an https:// URL.
FORMS_WEBHOOK_URL=
# Optional shared secret, sent as the "secret" JSON field and the X-Forms-Secret header,
# so the receiver can ignore requests that did not come from this site.
# The receiver must answer `ok` or JSON {"ok":true}; anything else counts as a failed delivery.
FORMS_WEBHOOK_SECRET=

# Option B: email via Resend (https://resend.com). Both values below are required.
RESEND_API_KEY=
# Inbox(es) that receive submissions, comma-separated.
FORMS_TO_EMAIL=sos@organize4syria.com
# Sender address on a domain verified in Resend, e.g. "Students Organize For Syria <forms@organize4syria.com>".
# If empty, onboarding@resend.dev is used, which can only deliver to the Resend account owner's address.
FORMS_FROM_EMAIL=
